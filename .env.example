OPENROUTER_API_KEY=
APP_PASSWORD=
SESSION_SECRET=

# Comma-separated OpenRouter model allow-list for full content packs.
CONTENT_MODEL_IDS=deepseek/deepseek-v4-flash,deepseek/deepseek-v4-flash-0731,~z-ai/glm-latest,openai/gpt-5.6-luna,google/gemini-3.8-flash,anthropic/claude-haiku-4.5,x-ai/grok-4.6
CONTENT_DEFAULT_MODEL=deepseek/deepseek-v4-flash

# USD per million tokens. Models above either ceiling are disabled.
CONTENT_MAX_INPUT_PRICE=2
CONTENT_MAX_OUTPUT_PRICE=6
